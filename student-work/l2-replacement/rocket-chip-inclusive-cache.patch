+package sifive.blocks.inclusivecache
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config.Field
+import freechips.rocketchip.util._
+
+sealed trait InclusiveCacheReplacementPolicy {
+  def name: String
+}
+
+object InclusiveCacheReplacementPolicy {
+  case object Random extends InclusiveCacheReplacementPolicy { val name = "random" }
+  case object PLRU extends InclusiveCacheReplacementPolicy { val name = "PLRU" }
+  case object TrueLRU extends InclusiveCacheReplacementPolicy { val name = "true LRU" }
+  case object BIP extends InclusiveCacheReplacementPolicy { val name = "BIP" }
+  case object DIP extends InclusiveCacheReplacementPolicy { val name = "DIP" }
+}
+
+case class InclusiveCacheReplacementConfig(
+  policy: InclusiveCacheReplacementPolicy = InclusiveCacheReplacementPolicy.Random,
+  bipMruProbabilityNumerator: Int = 1,
+  bipMruProbabilityDenominator: Int = 32,
+  leaderSetsPerPolicy: Int = 16,
+  pselCounterWidth: Int = 10
+)
+
+case object InclusiveCacheReplacementKey
+  extends Field[InclusiveCacheReplacementConfig](InclusiveCacheReplacementConfig())
+
+/** Event-oriented interface for future replacement implementations.
+  * Hits, new allocations, and invalidations are intentionally separate.
+  */
+abstract class InclusiveCacheReplacementState(val params: InclusiveCacheParameters) {
+  def victimWayOH(readEnable: Bool, resultValid: Bool): UInt
+  def acceptedHit(set: UInt, way: UInt, enable: Bool): Unit
+  def allocation(set: UInt, way: UInt, enable: Bool): Unit
+  def invalidation(set: UInt, way: UInt, enable: Bool): Unit
+}
+
+/** The pinned source's existing LFSR victim selection, kept bit-for-bit. */
+class RandomInclusiveCacheReplacementState(params: InclusiveCacheParameters)
+  extends InclusiveCacheReplacementState(params) {
+  def victimWayOH(readEnable: Bool, resultValid: Bool): UInt = {
+    val victimLFSR = random.LFSR(width = 16, params.dirReg(readEnable))(
+      InclusiveCacheParameters.lfsrBits - 1, 0)
+    val victimSums = Seq.tabulate(params.cache.ways) { i =>
+      ((1 << InclusiveCacheParameters.lfsrBits) * i / params.cache.ways).U
+    }
+    val victimLTE = Cat(victimSums.map { _ <= victimLFSR }.reverse)
+    val victimSimp = Cat(0.U(1.W), victimLTE(params.cache.ways - 1, 1), 1.U(1.W))
+    val victimWayOH = victimSimp(params.cache.ways - 1, 0) & ~(victimSimp >> 1)
+    assert (!resultValid || victimLTE(0) === 1.U)
+    assert (!resultValid || ((victimSimp >> 1) & ~victimSimp) === 0.U)
+    assert (!resultValid || PopCount(victimWayOH) === 1.U)
+
+    victimWayOH
+  }
+
+  def acceptedHit(set: UInt, way: UInt, enable: Bool): Unit = {}
+  def allocation(set: UInt, way: UInt, enable: Bool): Unit = {}
+  def invalidation(set: UInt, way: UInt, enable: Bool): Unit = {}
+}
+
+object InclusiveCacheReplacementState {
+  def unimplemented(policy: InclusiveCacheReplacementPolicy): Nothing =
+    throw new IllegalArgumentException(
+      s"requirement failed: InclusiveCache replacement policy '${policy.name}' is not implemented " +
+        "at this revision; only the existing random policy is available.")
+
+  def apply(params: InclusiveCacheParameters): InclusiveCacheReplacementState =
+    params.replacement.policy match {
+      case InclusiveCacheReplacementPolicy.Random  => new RandomInclusiveCacheReplacementState(params)
+      case InclusiveCacheReplacementPolicy.PLRU    => new PLRUInclusiveCacheReplacementState(params)
+      case InclusiveCacheReplacementPolicy.TrueLRU => new TrueLRUInclusiveCacheReplacementState(params)
+      case InclusiveCacheReplacementPolicy.BIP     => new BIPInclusiveCacheReplacementState(params)
+      case InclusiveCacheReplacementPolicy.DIP     => new DIPInclusiveCacheReplacementState(params)
+    }
+}
