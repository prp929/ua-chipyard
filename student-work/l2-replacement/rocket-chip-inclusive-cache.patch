+package sifive.blocks.inclusivecache
+
+import chisel3._
+import chisel3.util._
+
+/** Simulation-only L2 hit/miss instrumentation; it has no effect on cache behavior.
+  *
+  * Every directory lookup result is one L2 access, and a lookup that does not
+  * hit is an L2 miss. After each window of `windowAccesses` accesses it prints
+  *   L2WINDOW,<cycles since reset>,<accesses>,<misses>
+  * when the simulator runs with +verbose. Windows are additive across banks.
+  * A trailing partial window is never printed.
+  */
+object L2AccessMonitor {
+  val windowAccesses = 64
+
+  def apply(valid: Bool, hit: Bool): Unit = {
+    val cycle    = RegInit(0.U(64.W))
+    val accesses = RegInit(0.U(log2Ceil(windowAccesses).W))
+    val misses   = RegInit(0.U(32.W))
+    val windowMisses = misses + (valid && !hit).asUInt
+
+    cycle := cycle + 1.U
+    when (valid) {
+      accesses := accesses + 1.U
+      misses := windowMisses
+      when (accesses === (windowAccesses - 1).U) {
+        printf("L2WINDOW,%d,%d,%d\n", cycle, windowAccesses.U, windowMisses)
+        misses := 0.U
+      }
+    }
+  }
+}
